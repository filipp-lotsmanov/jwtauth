# Signing key for HS256. 32 random bytes, base64url, no padding.
# Generate with: go run ./cmd/genkey
JWT_SECRET=

# Stamped into every token as `iss` and enforced on verification.
JWT_ISSUER=jwtauth-learning

PORT=8080

# Access token lifetime. Short by design: it cannot be revoked, so the
# window of a stolen one is capped by this value alone.
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime, reset on every rotation (sliding expiry).
# 336h = 14 days.
REFRESH_TOKEN_TTL=336h

# bcrypt work factor. 10 is ~100ms per hash on current hardware.
BCRYPT_COST=10

# Secure flag on the refresh cookie. Browsers reject Secure cookies over
# plain HTTP, so this must be false for local http://localhost and true
# everywhere else. Defaults to true here so a missing value fails safe.
COOKIE_SECURE=true

SEED_USER_EMAIL=dev@example.com
SEED_USER_PASSWORD=